{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": "../../../",
		"ignoreDeprecations": "6.0",
		"rewriteRelativeImportExtensions": true,
		"outDir": "../petra",
		"rootDir": ".",
		"strict": false,
		"noCheck": false
	},
	"include": ["./**/*.ts", "./*.d.ts"],
	"exclude": ["./**/*.js"]
}
