{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": "../../../",
		"ignoreDeprecations": "6.0",
		"rewriteRelativeImportExtensions": true,
		"outDir": "../petra",
		"rootDir": ".",
		"strict": true,
		"noCheck": false,
		"noEmit": true,
		// The port must not see Node's globals: it runs in the engine. Tests
		// opt back in through tests/tsconfig.json.
		"types": [],
	},
	"include": ["./**/*.ts", "./*.d.ts"],
	"exclude": ["./**/*.js", "./tests/**"]
}
