{
	// Tests are TypeScript that runs on Node, not on the engine, so they get
	// Node's types and are kept out of the mod's own build and type check.
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["./**/*.ts", "../**/*.d.ts"],
	// The inherited exclude would drop this whole directory.
	"exclude": []
}
