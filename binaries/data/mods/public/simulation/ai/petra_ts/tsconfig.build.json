{
	// Emit config for the petra port comparison. Type checking lives in
	// tsconfig.json (strict + noEmit); this only transpiles, so a stray type
	// error never blocks getting JS out for the comparator.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"noCheck": true,
		"outDir": "../petra_out"
	},
	// Tests run against the emitted JS; they are not part of the mod.
	"exclude": ["./**/*.js", "./tests/**"]
}
