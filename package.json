{
	"type": "module",
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.6.1",
		"eslint": "^9.39.2",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"build:petra": "tsc -p build/petra_ts/tsconfig.json",
		"build:petra:out": "node build/petra_ts/prepare-bot.ts clean && tsc -p build/petra_ts/tsconfig.build.json && node build/petra_ts/prepare-bot.ts",
		"build:petra:baselines": "node build/petra_ts/baselines.ts",
		"match:petra": "build/petra_ts/match.sh",
		"batch:petra": "node build/petra_ts/batch.ts",
		"test:petra": "node binaries/data/mods/public/simulation/ai/petra_ts/tests/run.ts",
		"test:petra:match": "node --test build/petra_ts/match.test.ts",
		"test:petra:smoke": "node build/petra_ts/smoke.ts",
		"test:petra:tools": "node --test build/petra_ts/batch-stats.test.ts",
		"test:petra:out": "npm run build:petra:out && node binaries/data/mods/public/simulation/ai/petra_ts/tests/run.ts out",
		"test:petra:coverage": "node binaries/data/mods/public/simulation/ai/petra_ts/tests/run.ts src --coverage",
		"coverage:petra": "node binaries/data/mods/public/simulation/ai/petra_ts/tests/coverage.ts",
		"typecheck:petra:tests": "tsc -p build/petra_ts/tsconfig.tests.json"
	},
	"dependencies": {
		"@types/node": "^26.6.5"
	}
}
