{
	// Tests are TypeScript that runs on Node, not on the engine, so they get
	// Node's types and are kept out of the mod's own build and type check.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"skipLibCheck": true,
		// prepare-bot.ts and the match scripts sit outside the port; nothing is emitted anyway
		"rootDir": "../..",
		"noEmit": true
	},
	"include": [
		"../../binaries/data/mods/public/simulation/ai/petra_ts/tests/**/*.ts",
		"../../binaries/data/mods/public/simulation/ai/petra_ts/**/*.d.ts",
		"./prepare-bot.ts",
		"./match-report.ts",
		"./match-checks.ts",
		"./match.test.ts",
		"./baselines.ts",
		"./batch.ts",
		"./batch-stats.ts",
		"./batch-stats.test.ts",
		"./command-diff.ts",
		"./parity-bisect.ts",
		"./ai-times.ts"
	],
	// The inherited exclude would drop the tests directory.
	"exclude": []
}
