{
	// Emit config for the petra port: this is the JS the game loads. Type
	// checking lives in tsconfig.json (strict + noEmit); this only transpiles,
	// so a stray type error never blocks getting JS out. prepare-bot.ts then
	// turns the output into the "Petra TS" bot (npm run build:petra:out).
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"noCheck": true,
		"outDir": "../../binaries/data/mods/public/simulation/ai/petra_out"
	}
}
